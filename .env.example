# ============================================================================
# Supply Chain Disruption Response Assistant - Environment Configuration
# ============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/chainsolve_db
# If left empty, repository operates seamlessly with thread-safe memory/JSON persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chainsolve_db

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Disruption Notice Parsing Engine (Optional)
# If left blank, the deterministic rule-based NLP extraction pipeline operates automatically
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Logging
LOG_LEVEL=INFO
